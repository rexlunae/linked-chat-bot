# LinkedIn Chat Bot Configuration
# Copy this file to .env and fill in your credentials

# LinkedIn credentials (required)
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-linkedin-password

# OpenAI configuration (required)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4

# Google Calendar (optional)
GOOGLE_CREDENTIALS_PATH=google_credentials.json
GOOGLE_CALENDAR_ID=primary

# User profile information (for AI context)
USER_NAME=Your Name
USER_EMAIL=your-email@example.com
USER_PHONE=+1-555-555-5555
USER_LOCATION=San Francisco, CA
USER_AVAILABILITY=Weekdays 9am-5pm PST
USER_CURRENT_ROLE=Senior Software Engineer
USER_TARGET_ROLE=Staff Engineer
USER_SALARY_EXPECTATIONS=$200k-$250k
USER_NOTES=Looking for remote-first companies
